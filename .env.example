# ---------------------------------------------------------------------------
# Repo-root env, consumed by `docker compose`. Copy to `.env`:
#   cp .env.example .env
# `.env` is git-ignored. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Postgres container ---
POSTGRES_USER=circleup
POSTGRES_PASSWORD=circleup
POSTGRES_DB=circleup

# --- Backend (only needed if you run the `backend` compose service) ---
RUST_LOG=info,circleup_backend=debug
# The app's view of the API host. localhost works for the iOS simulator; use
# http://10.0.2.2:8080 for the Android emulator or http://<LAN-ip>:8080 for a device.
PUBLIC_URL=http://localhost:8080

# Generate: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=2592000
JWT_ISSUER=circleup

# Google OAuth — see README "Google Sign-In setup"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare R2 — see README "Cloudflare R2 setup"
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=circleup-dev
R2_PUBLIC_BASE_URL=
