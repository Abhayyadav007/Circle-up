# ---------------------------------------------------------------------------
# Circleup backend — copy to `backend/.env` and fill in.
# The repo-root `.env` (used by docker-compose) is a separate file; this one is
# read by `cargo run` / `cargo test` for a NATIVE run against the dockerized DB.
# ---------------------------------------------------------------------------

# --- Server ---
PORT=8080
RUST_LOG=info,circleup_backend=debug
LOG_JSON=false
# Public URL of THIS server as the mobile app reaches it. Used to build image
# URLs when running with local-disk storage (no R2). Match it to the app's
# apiBaseUrl host: http://localhost:8080 (iOS sim), http://10.0.2.2:8080
# (Android emulator), http://<your-LAN-ip>:8080 (physical device).
PUBLIC_URL=http://localhost:8080

# --- Database ---
# Native run (host) -> localhost. Inside the docker network the host is `postgres`.
DATABASE_URL=postgres://circleup:circleup@localhost:5432/circleup
DATABASE_MAX_CONNECTIONS=10
RUN_MIGRATIONS_ON_START=true

# --- JWT (our own sessions) ---
# Generate: `openssl rand -hex 48`
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECS=900
JWT_REFRESH_TTL_SECS=2592000
JWT_ISSUER=circleup

# --- Google OAuth (Sign in with Google) ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs.
# Create a "Web" client for the backend and platform clients for the mobile app;
# the CLIENT_ID below must match the `aud` of the ID tokens the app sends.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Image storage ---
# Leave the R2_* vars blank for local dev: the server falls back to on-disk
# storage under LOCAL_STORAGE_DIR and serves images itself at /media/<key>.
# Set all four R2_ACCESS/SECRET/ACCOUNT/BUCKET vars to switch to Cloudflare R2
# (see README "Cloudflare R2 setup"). No code changes needed.
LOCAL_STORAGE_DIR=./uploads

# --- Cloudflare R2 (S3-compatible object storage) — optional ---
# Cloudflare dashboard -> R2 -> Create bucket, then "Manage R2 API Tokens".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=circleup-dev
# Enable "Public access" on the bucket (r2.dev URL) or attach a custom domain,
# then put that base URL here (no trailing slash).
R2_PUBLIC_BASE_URL=
R2_PRESIGN_TTL_SECS=900
