# --- Secrets / env ---
.env
.env.*
!.env.example
backend/.env
mobile/.env

# --- Rust ---
/backend/target/
**/*.rs.bk

# --- Local dev image storage (used when R2 is not configured) ---
/backend/uploads/

# --- Node / React Native ---
node_modules/
mobile/node_modules/
mobile/.expo/
mobile/dist/
mobile/web-build/
*.log
npm-debug.*
yarn-debug.*
yarn-error.*

# --- Native projects (Expo Continuous Native Generation) ---
# `ios/` and `android/` are generated by `npx expo prebuild` — regenerate rather
# than edit. Delete these two lines if your team commits native projects instead.
mobile/ios/
mobile/android/

# --- Native mobile build output ---
mobile/ios/Pods/
mobile/ios/build/
mobile/android/.gradle/
mobile/android/app/build/
mobile/android/build/
*.keystore
!debug.keystore

# --- Stray root lockfile (npm run in the wrong dir) ---
/package-lock.json
/node_modules/

# --- Editors / OS ---
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
