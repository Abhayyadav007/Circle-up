# The mobile app reads runtime config from app.json -> expo.extra (see
# src/config/env.ts), NOT from a .env file by default. This file documents what
# you need to set there (or wire up via `app.config.ts` + EAS secrets).
#
#   expo.extra.apiBaseUrl        -> http://<your-LAN-ip>:8080/api/v1  (physical device)
#                                   http://localhost:8080/api/v1      (iOS simulator)
#                                   http://10.0.2.2:8080/api/v1       (Android emulator)
#   expo.extra.googleWebClientId -> Google OAuth *Web* client ID (must match backend GOOGLE_CLIENT_ID)
#   expo.extra.googleIosClientId -> Google OAuth iOS client ID (for the iOS URL scheme)

API_BASE_URL=http://localhost:8080/api/v1
GOOGLE_WEB_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
